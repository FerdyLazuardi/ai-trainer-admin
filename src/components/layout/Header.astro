---
// Main Canvas Top Header (Title, Subtitle, WIB Clock, Refresh)
---
<header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2">
  <div>
    <h1 id="page-title" class="text-2xl font-extrabold text-gray-900 tracking-tight">Spreadsheet Sync</h1>
    <p id="page-subtitle" class="text-xs text-gray-400 mt-0.5">Automated synchronization and telemetry management</p>
  </div>

  <!-- Top Tools & Badges -->
  <div class="flex items-center gap-3">
    <div id="wib-clock" class="text-xs font-mono font-medium px-3 py-1.5 rounded-xl bg-gray-50 border border-gray-200/80 text-gray-600 tabular-nums">
      00:00:00 WIB
    </div>

    <button id="btn-refresh-all" type="button" class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-white hover:bg-gray-50 border border-gray-200/80 text-xs font-semibold text-gray-700 shadow-xs transition-colors cursor-pointer">
      <svg class="w-3.5 h-3.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
      <span>Refresh</span>
    </button>
  </div>
</header>
