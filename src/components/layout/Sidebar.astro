---
// Left Sidebar Navigation
---
<aside id="main-sidebar" class="w-72 lg:w-64 h-full bg-[#F3F4F6] shrink-0 flex flex-col justify-between py-4 lg:py-2 px-3 lg:px-1 select-none space-y-6 transition-[width] duration-200 overflow-y-auto">
  <div class="space-y-6">
    
    <!-- Brand & Product Title & Collapse / Mobile Close Toggle -->
    <div class="sidebar-header flex items-center justify-between px-3">
      <div class="sidebar-brand-logo sidebar-text min-w-0">
        <div class="font-extrabold text-base text-gray-900 tracking-tight leading-tight">Dashboard</div>
        <div class="font-bold text-xs text-gray-500 tracking-wide leading-tight mt-0.5">Ai - Trainer</div>
      </div>

      <!-- Desktop Collapse Button -->
      <button id="sidebar-toggle-btn" title="Toggle Sidebar" class="hidden lg:flex w-7 h-7 rounded-lg border border-gray-200/80 bg-white/80 hover:bg-white text-gray-500 hover:text-gray-900 items-center justify-center cursor-pointer transition-all shrink-0 shadow-2xs">
        <svg id="sidebar-toggle-icon" class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      </button>

      <!-- Mobile Close Button inside Drawer -->
      <button id="mobile-sidebar-close" title="Close Menu" class="lg:hidden w-8 h-8 rounded-xl border border-gray-200/80 bg-white text-gray-500 hover:text-gray-900 flex items-center justify-center cursor-pointer shadow-2xs">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Navigation Tabs (Categorized & Pill Style) -->
    <nav class="space-y-5 px-1">
      <div>
        <div class="sidebar-text text-[10px] font-bold text-gray-400 uppercase tracking-wider px-3 mb-2">Ingestion</div>
        <ul class="space-y-1">
          <li>
            <button data-tab="sync" title="Spreadsheet Sync" class="tab-btn active w-full flex items-center gap-3 px-4 py-2.5 rounded-full text-xs font-semibold text-gray-900 bg-white shadow-xs cursor-pointer transition-all">
              <svg class="w-4 h-4 text-gray-900 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
              <span class="sidebar-text truncate">Spreadsheet Sync</span>
            </button>
          </li>
          <li>
            <button data-tab="convert" title="Convert to Markdown" class="tab-btn w-full flex items-center gap-3 px-4 py-2.5 rounded-full text-xs font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-200/60 cursor-pointer transition-all">
              <svg class="w-4 h-4 text-gray-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              <span class="sidebar-text truncate">Convert Markdown</span>
            </button>
          </li>
        </ul>
      </div>

      <div>
        <div class="sidebar-text text-[10px] font-bold text-gray-400 uppercase tracking-wider px-3 mb-2">Analytics</div>
        <ul class="space-y-1">
          <li>
            <button data-tab="logs" title="Chat Logs" class="tab-btn w-full flex items-center gap-3 px-4 py-2.5 rounded-full text-xs font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-200/60 cursor-pointer transition-all">
              <svg class="w-4 h-4 text-gray-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
              <span class="sidebar-text truncate">Chat Logs</span>
            </button>
          </li>
          <li>
            <button data-tab="kpi" title="Spreadsheet KPI" class="tab-btn w-full flex items-center gap-3 px-4 py-2.5 rounded-full text-xs font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-200/60 cursor-pointer transition-all">
              <svg class="w-4 h-4 text-gray-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
              <span class="sidebar-text truncate">Spreadsheet KPI</span>
            </button>
          </li>
          <li>
            <button data-tab="kb" title="Active Knowledge" class="tab-btn w-full flex items-center gap-3 px-4 py-2.5 rounded-full text-xs font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-200/60 cursor-pointer transition-all">
              <svg class="w-4 h-4 text-gray-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
              <span class="sidebar-text truncate">Active Knowledge</span>
            </button>
          </li>
          <li>
            <button data-tab="prompts" title="System Prompts" class="tab-btn w-full flex items-center gap-3 px-4 py-2.5 rounded-full text-xs font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-200/60 cursor-pointer transition-all">
              <svg class="w-4 h-4 text-gray-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
              <span class="sidebar-text truncate">System Prompts</span>
            </button>
          </li>
        </ul>
      </div>
    </nav>

  </div>
</aside>
