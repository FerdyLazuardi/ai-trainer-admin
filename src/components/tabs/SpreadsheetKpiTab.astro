---
// src/components/tabs/SpreadsheetKpiTab.astro
---

<div id="tab-content-kpi" class="tab-pane hidden space-y-6">

  <!-- Top Summary Cards (3 Columns) -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    
    <div class="p-4 rounded-2xl bg-white border border-gray-200/80 shadow-xs flex flex-col justify-between hover:border-gray-300 transition-all">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-gray-500">PostgreSQL Records</span>
        <div class="w-8 h-8 rounded-full border border-gray-200/80 flex items-center justify-center text-gray-400 bg-gray-50/50">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/></svg>
        </div>
      </div>
      <div class="mt-2">
        <span id="kpi-total-badge" class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight tabular-nums">-</span>
        <span class="text-xs font-semibold text-gray-600 bg-gray-100 border border-gray-200 px-2 py-0.5 rounded-md ml-2">Postgres Live</span>
      </div>
      <span class="text-[11px] text-gray-400 mt-1">Queried from Proxmox DB</span>
    </div>

    <div class="p-4 rounded-2xl bg-white border border-gray-200/80 shadow-xs flex flex-col justify-between hover:border-gray-300 transition-all">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-gray-500">Data Source</span>
        <div class="w-8 h-8 rounded-full border border-gray-200/80 flex items-center justify-center text-gray-400 bg-gray-50/50">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        </div>
      </div>
      <div class="mt-2">
        <span class="text-lg font-bold text-gray-900">PostgreSQL</span>
      </div>
      <span class="text-[11px] text-gray-400 mt-1">table: user_kpi_data</span>
    </div>

    <div class="p-4 rounded-2xl bg-white border border-gray-200/80 shadow-xs flex flex-col justify-between hover:border-gray-300 transition-all">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-gray-500">Target Users</span>
        <div class="w-8 h-8 rounded-full border border-gray-200/80 flex items-center justify-center text-gray-400 bg-gray-50/50">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        </div>
      </div>
      <div class="mt-2">
        <div id="kpi-target-roles" class="flex flex-wrap items-center gap-1.5 py-0.5" title="Active roles in KPI dataset">
          <span class="text-xs font-bold text-gray-400">Loading roles...</span>
        </div>
      </div>
      <span id="kpi-target-subtitle" class="text-[11px] text-gray-400 mt-2 block">Hierarchy: Point → Area → Reg → Pulau</span>
    </div>

  </div>

  <!-- KPI Table Section -->
  <div class="space-y-4">
    
    <!-- Search & Filter Bar (Vocalyn Exact Match) -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div class="relative w-full sm:w-80">
        <input
          id="kpi-search-input"
          type="text"
          placeholder="Search NIK or employee name..."
          class="w-full pl-9 pr-4 py-2.5 rounded-2xl bg-gray-50 border border-gray-200 text-xs text-gray-800 placeholder-gray-400 focus:bg-white focus:outline-none focus:border-gray-400 shadow-xs"
        />
        <svg class="w-4 h-4 text-gray-400 absolute left-3 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      </div>

      <div class="flex items-center gap-2 flex-wrap sm:flex-nowrap">
        <select id="kpi-role-filter" class="px-3.5 py-2 rounded-2xl bg-white border border-gray-200 text-xs font-semibold text-gray-700 focus:outline-none shadow-xs cursor-pointer max-w-[210px] sm:max-w-none">
          <option value="ALL">All Roles</option>
        </select>

        <button id="btn-reload-kpi" class="px-3.5 py-2 rounded-2xl bg-gray-900 text-white text-xs font-semibold hover:bg-black shadow-xs cursor-pointer">
          Search
        </button>

        <button id="btn-delete-all-kpi" class="px-3.5 py-2 rounded-2xl bg-rose-50 border border-rose-200 text-rose-700 text-xs font-semibold hover:bg-rose-100 active:bg-rose-200 shadow-xs cursor-pointer flex items-center gap-1.5 transition-colors" title="Delete all KPI records from PostgreSQL">
          <svg class="w-3.5 h-3.5 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
          <span>Delete All</span>
        </button>
      </div>
    </div>

    <!-- Table -->
    <div class="rounded-3xl border border-gray-200/80 overflow-hidden shadow-xs">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-gray-50/80 border-b border-gray-200/80 text-gray-400 uppercase text-[10px] font-bold tracking-wider">
            <tr>
              <th class="py-3.5 px-4">NIK</th>
              <th class="py-3.5 px-4">Employee Name</th>
              <th class="py-3.5 px-4">Role</th>
              <th class="py-3.5 px-4">Branch Point</th>
              <th class="py-3.5 px-4">Area & Regional</th>
              <th class="py-3.5 px-4">KPI Score</th>
              <th class="py-3.5 px-4 text-right">KPI Status</th>
            </tr>
          </thead>
          <tbody id="kpi-table-rows" class="divide-y divide-gray-100 bg-white text-gray-700">
            <tr><td colspan="7" class="py-8 text-center text-gray-400">Loading records from PostgreSQL...</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Pagination Controls (Vocalyn Exact Match) -->
    <div class="flex items-center justify-between pt-2 text-xs text-gray-500 font-sans">
      <span id="kpi-page-indicator">Showing records</span>
      
      <div class="flex items-center gap-1.5 font-semibold">
        <button id="btn-kpi-prev" class="w-8 h-8 rounded-xl border border-gray-200 bg-white text-gray-600 hover:bg-gray-50 flex items-center justify-center disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer shadow-xs">
          ‹
        </button>
        <span id="kpi-current-page" class="w-8 h-8 rounded-xl bg-gray-900 text-white text-xs flex items-center justify-center font-bold">1</span>
        <button id="btn-kpi-next" class="w-8 h-8 rounded-xl border border-gray-200 bg-white text-gray-600 hover:bg-gray-50 flex items-center justify-center cursor-pointer shadow-xs">
          ›
        </button>
      </div>
    </div>

  </div>

</div>
