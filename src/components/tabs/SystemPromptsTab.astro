---
// src/components/tabs/SystemPromptsTab.astro
---

<div id="tab-content-prompts" class="tab-pane hidden space-y-4">

  <!-- Header & Live Dynamic Status -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-2 border-b border-gray-200/70">
    <div class="flex items-center gap-2.5">
      <h2 class="text-sm font-bold text-gray-900 tracking-tight">System Prompts & Context Directory</h2>
      <span id="prompt-source-badge" class="text-[11px] font-mono px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200/60 font-medium inline-flex items-center gap-1">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>backend: live</span>
      </span>
      <span class="text-[11px] text-gray-400 font-normal hidden sm:inline">• Judge evaluator excluded</span>
    </div>
  </div>

  <!-- Control Bar: Kiri Atas Pilihan File & Kanan Dropdown Filter + Search -->
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3">
    
    <!-- Kiri Atas: Pilihan File (prompts.py vs pipeline.py) -->
    <div class="flex items-center gap-1.5 p-1 rounded-2xl bg-gray-100 border border-gray-200/70 w-fit">
      <button
        id="btn-source-prompts"
        type="button"
        class="source-tab-btn active px-3.5 py-2 rounded-xl text-xs font-bold text-gray-900 bg-white shadow-xs cursor-pointer transition-all flex items-center gap-2"
      >
        <span class="w-2 h-2 rounded-full bg-blue-600"></span>
        <span>app/llm/prompts.py</span>
      </button>
      <button
        id="btn-source-pipeline"
        type="button"
        class="source-tab-btn px-3.5 py-2 rounded-xl text-xs font-semibold text-gray-500 hover:text-gray-900 cursor-pointer transition-all flex items-center gap-2"
      >
        <span class="w-2 h-2 rounded-full bg-amber-500"></span>
        <span>app/graph/pipeline.py</span>
      </button>
    </div>

    <!-- Kanan: Filter Dropdown (Scroll ke bawah) + Search -->
    <div class="flex items-center gap-2 flex-wrap sm:flex-nowrap">
      
      <!-- Search Input -->
      <div class="relative w-full sm:w-60">
        <input
          id="prompt-search-input"
          type="text"
          placeholder="Search..."
          class="w-full pl-8 pr-3 py-2 rounded-2xl bg-gray-50 border border-gray-200 text-xs text-gray-800 placeholder-gray-400 focus:bg-white focus:outline-none focus:border-gray-400 shadow-2xs"
        />
        <svg class="w-3.5 h-3.5 text-gray-400 absolute left-2.5 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      </div>

      <!-- Dropdown Filter (Dinamis sesuai file yang aktif) -->
      <select id="prompt-select-filter" class="px-3.5 py-2 rounded-2xl bg-white border border-gray-200 text-xs font-semibold text-gray-700 focus:outline-none shadow-xs cursor-pointer max-w-[270px] sm:max-w-none">
        <!-- Diisi otomatis oleh JavaScript sesuai pilihan file -->
      </select>

      <button id="btn-prompt-search" type="button" class="px-4 py-2 rounded-2xl bg-gray-900 text-white text-xs font-semibold hover:bg-black shadow-xs cursor-pointer transition-colors shrink-0">
        Search
      </button>
    </div>

  </div>

  <!-- Focused Minimal Card Viewer -->
  <div class="rounded-3xl border border-gray-200/80 bg-white p-5 sm:p-6 space-y-4 shadow-xs">
    
    <!-- Title & Action Row -->
    <div class="flex items-start justify-between gap-4">
      <div>
        <h3 id="min-viewer-title" class="text-base font-bold text-gray-900 tracking-tight">Conversational QA Prompt</h3>
        <p id="min-viewer-desc" class="text-xs text-gray-500 mt-0.5">Primary generation prompt for answering factual, policy, SOP, and operational questions.</p>
      </div>
      <button
        id="btn-copy-prompt"
        type="button"
        class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-2xl text-xs font-semibold text-gray-700 bg-gray-50 hover:bg-gray-100 border border-gray-200/80 cursor-pointer transition-all shrink-0 shadow-2xs"
        title="Copy prompt text"
      >
        <svg class="w-3.5 h-3.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg>
        <span>Copy</span>
      </button>
    </div>

    <!-- Quiet Act-As / Purpose Box -->
    <div class="border-l-3 border-blue-600 pl-3.5 py-1 bg-blue-50/40 rounded-r-xl">
      <div class="text-[10px] font-bold uppercase tracking-wider text-blue-800">Acts As / Purpose</div>
      <div id="min-viewer-act-as" class="text-xs sm:text-sm font-semibold text-gray-900 mt-0.5">
        Senior Learning & Development Trainer at Amartha (Digital Learning Team)
      </div>
    </div>

    <!-- Clean Metadata Specs Line -->
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px] text-gray-500 border-y border-gray-100 py-2">
      <div><span class="text-gray-400">Tokens:</span> <span id="min-viewer-tokens" class="font-mono font-medium text-gray-700">~1850 tok</span></div>
      <div><span class="text-gray-400">Cache:</span> <span id="min-viewer-cache" class="font-medium text-emerald-700">Prefix Cacheable</span></div>
      <div><span class="text-gray-400">Pipeline:</span> <span id="min-viewer-stage" class="font-medium text-gray-700">Production Graph _generate_node</span></div>
      <div class="w-full sm:w-auto"><span class="text-gray-400">Trigger:</span> <span id="min-viewer-trigger" class="font-medium text-gray-700">KNOWLEDGE • TOPIC_LIST</span></div>
    </div>

    <!-- Clean Readable Monospace Content Box -->
    <div class="rounded-2xl border border-gray-200/90 bg-gray-50/60 p-4 max-h-[580px] overflow-y-auto font-mono text-[11px] sm:text-xs text-gray-800 leading-relaxed whitespace-pre-wrap selection:bg-gray-200 shadow-2xs">
      <pre id="min-viewer-code" class="whitespace-pre-wrap font-mono">Loading prompt content...</pre>
    </div>

  </div>

</div>
