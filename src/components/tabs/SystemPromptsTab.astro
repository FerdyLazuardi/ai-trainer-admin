---
// src/components/tabs/SystemPromptsTab.astro
---

<div id="tab-content-prompts" class="tab-pane hidden space-y-4">

  <!-- Header & Live Dynamic Status -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-2 border-b border-gray-200/70">
    <div class="flex items-center gap-2.5">
      <h2 class="text-sm font-bold text-gray-900 tracking-tight">System Prompts & Context Directory</h2>
      <span id="prompt-source-badge" class="text-[11px] font-mono px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200/60 font-medium inline-flex items-center gap-1">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>backend: live</span>
      </span>
      <span class="text-[11px] text-gray-400 font-normal hidden sm:inline">• Judge evaluator excluded</span>
    </div>
  </div>

  <!-- Top Metric Cards (3 Columns) -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">

    <!-- Total Prompt Tokens Card -->
    <div class="p-4 rounded-2xl bg-white border border-gray-200/80 shadow-xs flex flex-col justify-between hover:border-gray-300 transition-all">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Total Prompt Tokens</span>
        <div class="w-8 h-8 rounded-full border border-gray-200/80 flex items-center justify-center text-gray-400 bg-gray-50/50">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        </div>
      </div>
      <div class="mt-2 flex items-baseline gap-2">
        <span id="prompt-stat-tokens" class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight tabular-nums">-</span>
        <span class="text-xs font-semibold text-gray-600 bg-gray-100 border border-gray-200 px-2 py-0.5 rounded-md inline-flex items-center gap-0.5">tokens</span>
      </div>
      <span class="text-[11px] text-gray-400 mt-1">Preloaded in CAG System Context</span>
    </div>

    <!-- Source File Card -->
    <div class="p-4 rounded-2xl bg-white border border-gray-200/80 shadow-xs flex flex-col justify-between hover:border-gray-300 transition-all">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Source Code</span>
        <div class="w-8 h-8 rounded-full border border-gray-200/80 flex items-center justify-center text-gray-400 bg-gray-50/50">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
        </div>
      </div>
      <div class="mt-2 flex items-baseline gap-2">
        <span class="text-base sm:text-lg font-bold text-gray-900 font-mono">app/llm/prompts.py</span>
      </div>
      <span class="text-[11px] text-gray-400 mt-1">Modular XML Prompt Blocks</span>
    </div>

    <!-- Cache Strategy Card -->
    <div class="p-4 rounded-2xl bg-white border border-gray-200/80 shadow-xs flex flex-col justify-between hover:border-gray-300 transition-all">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Cache Strategy</span>
        <div class="w-8 h-8 rounded-full border border-gray-200/80 flex items-center justify-center text-emerald-600 bg-emerald-50/50">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
      </div>
      <div class="mt-2 flex items-baseline gap-2">
        <span class="text-base sm:text-lg font-bold text-emerald-700 inline-flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Byte-stable Prefix
        </span>
      </div>
      <span class="text-[11px] text-gray-400 mt-1">OpenRouter / Provider Context Caching</span>
    </div>

  </div>

  <!-- Focused Minimal Card Viewer -->
  <div class="rounded-3xl border border-gray-200/80 bg-white p-5 sm:p-6 space-y-4 shadow-xs">
    
    <!-- Title & Action Row -->
    <div class="flex items-start justify-between gap-4">
      <div>
        <h3 class="text-base font-bold text-gray-900 tracking-tight">Active System Prompt</h3>
        <p class="text-xs text-gray-500 mt-0.5">All modular XML prompt blocks combined from <code class="text-gray-700 bg-gray-100 px-1 py-0.5 rounded text-[11px] font-mono">app/llm/prompts.py</code></p>
      </div>
      <button
        id="btn-copy-prompt"
        type="button"
        class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-2xl text-xs font-semibold text-gray-700 bg-gray-50 hover:bg-gray-100 border border-gray-200/80 cursor-pointer transition-all shrink-0 shadow-2xs"
        title="Copy prompt text"
      >
        <svg class="w-3.5 h-3.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg>
        <span>Copy</span>
      </button>
    </div>

    <!-- Clean Metadata Specs Line -->
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px] text-gray-500 border-y border-gray-100 py-2">
      <div><span class="text-gray-400">Tokens:</span> <span id="min-viewer-tokens" class="font-mono font-medium text-gray-700">-</span></div>
      <div><span class="text-gray-400">Cache:</span> <span class="font-medium text-emerald-700">Prefix Cacheable</span></div>
      <div><span class="text-gray-400">Pipeline:</span> <span class="font-medium text-gray-700">app.llm.prompts (Full System Prompt)</span></div>
      <div class="w-full sm:w-auto"><span class="text-gray-400">Trigger:</span> <span class="font-medium text-gray-700">All Generation Turns</span></div>
    </div>

    <!-- Clean Readable Monospace Content Box -->
    <div class="rounded-2xl border border-gray-200/90 bg-gray-50/60 p-4 max-h-[580px] overflow-y-auto font-mono text-[11px] sm:text-xs text-gray-800 leading-relaxed whitespace-pre-wrap selection:bg-gray-200 shadow-2xs">
      <pre id="min-viewer-code" class="whitespace-pre-wrap font-mono">Loading prompt content...</pre>
    </div>

  </div>

</div>
