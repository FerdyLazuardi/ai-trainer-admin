---
// src/components/tabs/SystemPromptsTab.astro
---

<div id="tab-content-prompts" class="tab-pane hidden space-y-4">

  <!-- Header & Live Dynamic Status -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-2 border-b border-gray-200/70">
    <div class="flex items-center gap-2.5">
      <h2 class="text-sm font-bold text-gray-900 tracking-tight">System Prompts & Runtime Templates</h2>
      <span id="prompt-source-badge" class="text-[11px] font-mono px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200/60 font-medium inline-flex items-center gap-1">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>backend: live</span>
      </span>
      <span class="text-[11px] text-gray-400 font-normal hidden sm:inline">• Judge evaluator excluded</span>
    </div>

    <!-- Quick Search Input -->
    <div class="relative w-full sm:w-60">
      <input
        type="text"
        id="prompt-search-input"
        placeholder="Filter prompt or block..."
        class="w-full text-xs rounded-xl border border-gray-200 bg-white px-3 py-1.5 pl-8 text-gray-800 placeholder-gray-400 focus:outline-none focus:border-gray-400 shadow-2xs"
      />
      <svg class="w-3.5 h-3.5 text-gray-400 absolute left-2.5 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
    </div>
  </div>

  <!-- Primary File Switcher (prompts.py vs pipeline.py) -->
  <div class="flex items-center gap-2 p-1 rounded-xl bg-gray-100/90 border border-gray-200/70 w-fit">
    <button
      id="file-btn-prompts"
      data-source-file="prompts_py"
      class="source-file-btn active flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-bold text-gray-900 bg-white shadow-2xs cursor-pointer transition-all"
    >
      <svg class="w-3.5 h-3.5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      <span>app/llm/prompts.py</span>
      <span class="text-[10px] font-semibold text-gray-500 bg-gray-100 px-1.5 py-0.2 rounded-full">5 Prompts</span>
    </button>
    <button
      id="file-btn-pipeline"
      data-source-file="pipeline_py"
      class="source-file-btn flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold text-gray-500 hover:text-gray-900 cursor-pointer transition-all"
    >
      <svg class="w-3.5 h-3.5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2 1 3 3 3h10c2 0 3-1 3-3V7c0-2-1-3-3-3H7C5 4 4 5 4 7zM9 9h6M9 13h6M9 17h3"/></svg>
      <span>app/graph/pipeline.py</span>
      <span class="text-[10px] font-semibold text-gray-500 bg-gray-200/60 px-1.5 py-0.2 rounded-full">Context Blocks</span>
    </button>
  </div>

  <!-- SECTION 1: PROMPTS.PY CONTROLS -->
  <div id="section-prompts-py" class="space-y-2.5">
    <!-- Horizontal Prompt Selectors -->
    <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs border-b border-gray-100">
      <button data-prompt-id="conversational" class="prompt-item-btn active px-3 py-1.5 rounded-lg font-medium text-white bg-gray-900 cursor-pointer transition-all whitespace-nowrap">
        Conversational QA
      </button>
      <button data-prompt-id="socratic" class="prompt-item-btn px-3 py-1.5 rounded-lg font-medium text-gray-500 hover:text-gray-900 hover:bg-gray-100 cursor-pointer transition-all whitespace-nowrap">
        Socratic Coaching
      </button>
      <button data-prompt-id="chit_chat" class="prompt-item-btn px-3 py-1.5 rounded-lg font-medium text-gray-500 hover:text-gray-900 hover:bg-gray-100 cursor-pointer transition-all whitespace-nowrap">
        Chit-Chat
      </button>
      <button data-prompt-id="stm_summary" class="prompt-item-btn px-3 py-1.5 rounded-lg font-medium text-gray-500 hover:text-gray-900 hover:bg-gray-100 cursor-pointer transition-all whitespace-nowrap">
        STM Summary
      </button>
      <button data-prompt-id="ltm_analyst" class="prompt-item-btn px-3 py-1.5 rounded-lg font-medium text-gray-500 hover:text-gray-900 hover:bg-gray-100 cursor-pointer transition-all whitespace-nowrap">
        LTM Analyst
      </button>
      <button id="btn-toggle-prompt-blocks" class="px-3 py-1.5 rounded-lg font-medium text-amber-800 bg-amber-50 hover:bg-amber-100 cursor-pointer transition-all whitespace-nowrap border border-amber-200/60 ml-auto flex items-center gap-1.5">
        <span>Filter Blocks (7)</span>
        <svg class="w-3.5 h-3.5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      </button>
    </div>

    <!-- Filter Blocks Pill Row (prompts.py modular components) -->
    <div id="prompts-blocks-row" class="hidden flex items-center gap-1.5 overflow-x-auto pb-1 text-xs bg-amber-50/40 p-2 rounded-xl border border-amber-200/50">
      <span class="text-[10px] text-amber-800 font-bold uppercase tracking-wider mr-1 shrink-0">Modular XML:</span>
      <button data-block-id="role" class="block-item-btn px-2.5 py-1 rounded-md text-xs font-semibold text-gray-600 bg-white border border-gray-200 hover:bg-gray-100 cursor-pointer transition-all font-mono whitespace-nowrap">&lt;role&gt;</button>
      <button data-block-id="output_contract" class="block-item-btn px-2.5 py-1 rounded-md text-xs font-semibold text-gray-600 bg-white border border-gray-200 hover:bg-gray-100 cursor-pointer transition-all font-mono whitespace-nowrap">&lt;output_contract&gt;</button>
      <button data-block-id="grounding" class="block-item-btn px-2.5 py-1 rounded-md text-xs font-semibold text-gray-600 bg-white border border-gray-200 hover:bg-gray-100 cursor-pointer transition-all font-mono whitespace-nowrap">&lt;grounding&gt;</button>
      <button data-block-id="response_guidelines" class="block-item-btn px-2.5 py-1 rounded-md text-xs font-semibold text-gray-600 bg-white border border-gray-200 hover:bg-gray-100 cursor-pointer transition-all font-mono whitespace-nowrap">&lt;response_guidelines&gt;</button>
      <button data-block-id="mentoring_voice" class="block-item-btn px-2.5 py-1 rounded-md text-xs font-semibold text-gray-600 bg-white border border-gray-200 hover:bg-gray-100 cursor-pointer transition-all font-mono whitespace-nowrap">&lt;mentoring_voice&gt;</button>
      <button data-block-id="socratic_mode" class="block-item-btn px-2.5 py-1 rounded-md text-xs font-semibold text-gray-600 bg-white border border-gray-200 hover:bg-gray-100 cursor-pointer transition-all font-mono whitespace-nowrap">&lt;mode&gt;</button>
      <button data-block-id="disambig" class="block-item-btn px-2.5 py-1 rounded-md text-xs font-semibold text-gray-600 bg-white border border-gray-200 hover:bg-gray-100 cursor-pointer transition-all font-mono whitespace-nowrap">&lt;disambiguate&gt;</button>
    </div>
  </div>

  <!-- SECTION 2: PIPELINE.PY CONTROLS -->
  <div id="section-pipeline-py" class="hidden space-y-2.5">
    <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs border-b border-gray-100">
      <button data-pipeline-id="assembly_frame" class="pipeline-item-btn active px-3 py-1.5 rounded-lg font-medium text-white bg-gray-900 cursor-pointer transition-all whitespace-nowrap">
        Message Frame Architecture
      </button>
      <button data-pipeline-id="user_context" class="pipeline-item-btn px-3 py-1.5 rounded-lg font-medium text-gray-500 hover:text-gray-900 hover:bg-gray-100 cursor-pointer transition-all whitespace-nowrap font-mono">
        &lt;user_context&gt;
      </button>
      <button data-pipeline-id="user_history" class="pipeline-item-btn px-3 py-1.5 rounded-lg font-medium text-gray-500 hover:text-gray-900 hover:bg-gray-100 cursor-pointer transition-all whitespace-nowrap font-mono">
        &lt;user_history&gt;
      </button>
      <button data-pipeline-id="previous_context" class="pipeline-item-btn px-3 py-1.5 rounded-lg font-medium text-gray-500 hover:text-gray-900 hover:bg-gray-100 cursor-pointer transition-all whitespace-nowrap font-mono">
        &lt;previous_context&gt;
      </button>
      <button data-pipeline-id="available_topics" class="pipeline-item-btn px-3 py-1.5 rounded-lg font-medium text-gray-500 hover:text-gray-900 hover:bg-gray-100 cursor-pointer transition-all whitespace-nowrap font-mono">
        &lt;available_topics&gt;
      </button>
      <button data-pipeline-id="section_materials" class="pipeline-item-btn px-3 py-1.5 rounded-lg font-medium text-gray-500 hover:text-gray-900 hover:bg-gray-100 cursor-pointer transition-all whitespace-nowrap font-mono">
        &lt;section_materials&gt;
      </button>
      <button data-pipeline-id="knowledge_base" class="pipeline-item-btn px-3 py-1.5 rounded-lg font-medium text-gray-500 hover:text-gray-900 hover:bg-gray-100 cursor-pointer transition-all whitespace-nowrap font-mono">
        &lt;knowledge_base&gt;
      </button>
      <button data-pipeline-id="knowledge_base_missing" class="pipeline-item-btn px-3 py-1.5 rounded-lg font-medium text-gray-500 hover:text-gray-900 hover:bg-gray-100 cursor-pointer transition-all whitespace-nowrap font-mono">
        &lt;missing_kb&gt;
      </button>
    </div>
  </div>

  <!-- Focused Minimal Card Viewer -->
  <div class="rounded-2xl border border-gray-200/80 bg-white p-5 sm:p-6 space-y-4 shadow-2xs">
    
    <!-- Title & Action -->
    <div class="flex items-start justify-between gap-4">
      <div>
        <div class="flex items-center gap-2">
          <span id="min-viewer-filetag" class="text-[10px] font-mono font-bold uppercase tracking-wider px-2 py-0.5 rounded-md bg-blue-50 text-blue-700 border border-blue-200/60">app/llm/prompts.py</span>
          <h3 id="min-viewer-title" class="text-base font-bold text-gray-900 tracking-tight">Conversational QA Prompt</h3>
        </div>
        <p id="min-viewer-desc" class="text-xs text-gray-500 mt-1">Primary generation prompt for answering factual, policy, SOP, and operational questions.</p>
      </div>
      <button
        id="btn-copy-prompt"
        type="button"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium text-gray-700 bg-gray-50 hover:bg-gray-100 border border-gray-200/80 cursor-pointer transition-all shrink-0"
        title="Copy prompt text"
      >
        <svg class="w-3.5 h-3.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg>
        <span>Copy</span>
      </button>
    </div>

    <!-- Quiet Act-As / Role Box -->
    <div class="border-l-3 border-blue-600 pl-3.5 py-1 bg-blue-50/40 rounded-r-xl">
      <div class="text-[10px] font-bold uppercase tracking-wider text-blue-800">Acts As / Purpose</div>
      <div id="min-viewer-act-as" class="text-xs sm:text-sm font-semibold text-gray-900 mt-0.5">
        Senior Learning & Development Trainer at Amartha (Digital Learning Team)
      </div>
    </div>

    <!-- Clean Metadata Specs Line -->
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px] text-gray-500 border-y border-gray-100 py-2">
      <div><span class="text-gray-400">Tokens:</span> <span id="min-viewer-tokens" class="font-mono font-medium text-gray-700">~1850 tok</span></div>
      <div><span class="text-gray-400">Cache:</span> <span id="min-viewer-cache" class="font-medium text-emerald-700">Prefix Cacheable</span></div>
      <div><span class="text-gray-400">Pipeline:</span> <span id="min-viewer-stage" class="font-medium text-gray-700">Production Graph _generate_node</span></div>
      <div class="w-full sm:w-auto"><span class="text-gray-400">Trigger:</span> <span id="min-viewer-trigger" class="font-medium text-gray-700">KNOWLEDGE • TOPIC_LIST</span></div>
    </div>

    <!-- Clean Readable Monospace Content Box -->
    <div class="rounded-xl border border-gray-200/90 bg-gray-50/60 p-4 max-h-[580px] overflow-y-auto font-mono text-[11px] sm:text-xs text-gray-800 leading-relaxed whitespace-pre-wrap selection:bg-gray-200">
      <pre id="min-viewer-code" class="whitespace-pre-wrap font-mono">Loading prompt content...</pre>
    </div>

  </div>

</div>
