---
// src/components/tabs/SystemPromptsTab.astro
---

<div id="tab-content-prompts" class="tab-pane hidden space-y-4">

  <!-- Minimalist Header & Status -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-2 border-b border-gray-200/70">
    <div class="flex items-center gap-2.5">
      <h2 class="text-sm font-bold text-gray-900 tracking-tight">System Prompts</h2>
      <span id="prompt-source-badge" class="text-[11px] font-mono px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200/60 font-medium inline-flex items-center gap-1">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>backend live</span>
      </span>
      <span class="text-[11px] text-gray-400 font-normal hidden sm:inline">• Judge evaluator excluded</span>
    </div>

    <!-- Quick Search Input (Minimal) -->
    <div class="relative w-full sm:w-56">
      <input
        type="text"
        id="prompt-search-input"
        placeholder="Search prompt or block..."
        class="w-full text-xs rounded-xl border border-gray-200 bg-white px-3 py-1.5 pl-8 text-gray-800 placeholder-gray-400 focus:outline-none focus:border-gray-400 shadow-2xs"
      />
      <svg class="w-3.5 h-3.5 text-gray-400 absolute left-2.5 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
    </div>
  </div>

  <!-- Minimal Horizontal Tabs -->
  <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs border-b border-gray-100">
    <button data-prompt-tab="conversational" class="prompt-tab-btn active px-3 py-1.5 rounded-lg font-medium text-white bg-gray-900 cursor-pointer transition-all whitespace-nowrap">
      Conversational QA
    </button>
    <button data-prompt-tab="socratic" class="prompt-tab-btn px-3 py-1.5 rounded-lg font-medium text-gray-500 hover:text-gray-900 hover:bg-gray-100 cursor-pointer transition-all whitespace-nowrap">
      Socratic Coaching
    </button>
    <button data-prompt-tab="chit_chat" class="prompt-tab-btn px-3 py-1.5 rounded-lg font-medium text-gray-500 hover:text-gray-900 hover:bg-gray-100 cursor-pointer transition-all whitespace-nowrap">
      Chit-Chat
    </button>
    <button data-prompt-tab="stm_summary" class="prompt-tab-btn px-3 py-1.5 rounded-lg font-medium text-gray-500 hover:text-gray-900 hover:bg-gray-100 cursor-pointer transition-all whitespace-nowrap">
      STM Summary
    </button>
    <button data-prompt-tab="ltm_analyst" class="prompt-tab-btn px-3 py-1.5 rounded-lg font-medium text-gray-500 hover:text-gray-900 hover:bg-gray-100 cursor-pointer transition-all whitespace-nowrap">
      LTM Analyst
    </button>
    <button data-prompt-tab="cag_baseline" class="prompt-tab-btn px-3 py-1.5 rounded-lg font-medium text-gray-500 hover:text-gray-900 hover:bg-gray-100 cursor-pointer transition-all whitespace-nowrap">
      CAG Baseline
    </button>
    <button data-prompt-tab="blocks" class="prompt-tab-btn px-3 py-1.5 rounded-lg font-medium text-amber-800 bg-amber-50/80 hover:bg-amber-100/80 cursor-pointer transition-all whitespace-nowrap border border-amber-200/60 ml-auto">
      Modular Blocks (7)
    </button>
  </div>

  <!-- Sub-navigation for Modular XML Blocks (Visible only when 'blocks' tab active) -->
  <div id="blocks-subnav-container" class="hidden flex items-center gap-1.5 overflow-x-auto pb-1 text-xs">
    <span class="text-[11px] text-gray-400 font-semibold uppercase tracking-wider mr-1">Block:</span>
    <button data-block-tab="role" class="block-tab-btn active px-2.5 py-1 rounded-md text-xs font-semibold bg-gray-900 text-white cursor-pointer transition-all font-mono">&lt;role&gt;</button>
    <button data-block-tab="output_contract" class="block-tab-btn px-2.5 py-1 rounded-md text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 cursor-pointer transition-all font-mono">&lt;output_contract&gt;</button>
    <button data-block-tab="grounding" class="block-tab-btn px-2.5 py-1 rounded-md text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 cursor-pointer transition-all font-mono">&lt;grounding&gt;</button>
    <button data-block-tab="response_guidelines" class="block-tab-btn px-2.5 py-1 rounded-md text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 cursor-pointer transition-all font-mono">&lt;response_guidelines&gt;</button>
    <button data-block-tab="mentoring_voice" class="block-tab-btn px-2.5 py-1 rounded-md text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 cursor-pointer transition-all font-mono">&lt;mentoring_voice&gt;</button>
    <button data-block-tab="socratic_mode" class="block-tab-btn px-2.5 py-1 rounded-md text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 cursor-pointer transition-all font-mono">&lt;mode&gt;</button>
    <button data-block-tab="disambig" class="block-tab-btn px-2.5 py-1 rounded-md text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 cursor-pointer transition-all font-mono">&lt;disambiguate&gt;</button>
  </div>

  <!-- Focused Minimal Card -->
  <div class="rounded-2xl border border-gray-200/80 bg-white p-5 sm:p-6 space-y-4 shadow-2xs">
    
    <!-- Title & Action -->
    <div class="flex items-start justify-between gap-4">
      <div>
        <h3 id="min-viewer-title" class="text-base font-bold text-gray-900 tracking-tight">Conversational QA Prompt</h3>
        <p id="min-viewer-desc" class="text-xs text-gray-500 mt-0.5">Primary generation prompt for answering factual, policy, SOP, and operational questions.</p>
      </div>
      <button
        id="btn-copy-prompt"
        type="button"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium text-gray-700 bg-gray-50 hover:bg-gray-100 border border-gray-200/80 cursor-pointer transition-all shrink-0"
        title="Copy prompt text"
      >
        <svg class="w-3.5 h-3.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg>
        <span>Copy</span>
      </button>
    </div>

    <!-- Quiet Act-As Box (Minimalist Accent) -->
    <div class="border-l-3 border-blue-600 pl-3.5 py-1 bg-blue-50/40 rounded-r-xl">
      <div class="text-[10px] font-bold uppercase tracking-wider text-blue-800">Acts As</div>
      <div id="min-viewer-act-as" class="text-xs sm:text-sm font-semibold text-gray-900 mt-0.5">
        Senior Learning & Development Trainer at Amartha (Digital Learning Team)
      </div>
    </div>

    <!-- Clean Metadata Specs Line -->
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px] text-gray-500 border-y border-gray-100 py-2">
      <div><span class="text-gray-400">Tokens:</span> <span id="min-viewer-tokens" class="font-mono font-medium text-gray-700">~1850 tok</span></div>
      <div><span class="text-gray-400">Cache:</span> <span id="min-viewer-cache" class="font-medium text-emerald-700">Prefix Cacheable</span></div>
      <div><span class="text-gray-400">Pipeline:</span> <span id="min-viewer-stage" class="font-medium text-gray-700">Production Graph _generate_node</span></div>
      <div class="w-full sm:w-auto"><span class="text-gray-400">Trigger:</span> <span id="min-viewer-trigger" class="font-medium text-gray-700">KNOWLEDGE • TOPIC_LIST</span></div>
    </div>

    <!-- Clean Readable Monospace Content Box -->
    <div class="rounded-xl border border-gray-200/90 bg-gray-50/60 p-4 max-h-[580px] overflow-y-auto font-mono text-[11px] sm:text-xs text-gray-800 leading-relaxed whitespace-pre-wrap selection:bg-gray-200">
      <pre id="min-viewer-code" class="whitespace-pre-wrap font-mono">Loading prompt content...</pre>
    </div>

  </div>

</div>
