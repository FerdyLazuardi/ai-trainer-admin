---
// src/components/tabs/SystemPromptsTab.astro
---

<div id="tab-content-prompts" class="tab-pane hidden space-y-6">

  <!-- Top Metric Cards (4 Columns) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

    <!-- Active Production Prompts -->
    <div class="p-4 rounded-2xl bg-white border border-gray-200/80 shadow-xs flex flex-col justify-between hover:border-gray-300 transition-all">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Active Prompts</span>
        <div class="w-8 h-8 rounded-full border border-gray-200/80 flex items-center justify-center text-gray-400 bg-gray-50/50">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
        </div>
      </div>
      <div class="mt-2 flex items-baseline gap-2">
        <span id="stat-total-prompts" class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight tabular-nums">6</span>
        <span class="text-xs font-semibold text-blue-700 bg-blue-50 border border-blue-200/80 px-2 py-0.5 rounded-md">Live Agent</span>
      </div>
      <span class="text-[11px] text-gray-400 mt-1">Production graph & memory sets</span>
    </div>

    <!-- Modular XML Blocks -->
    <div class="p-4 rounded-2xl bg-white border border-gray-200/80 shadow-xs flex flex-col justify-between hover:border-gray-300 transition-all">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Modular Blocks</span>
        <div class="w-8 h-8 rounded-full border border-gray-200/80 flex items-center justify-center text-amber-500 bg-amber-50 font-mono font-bold text-xs">
          &lt;/&gt;
        </div>
      </div>
      <div class="mt-2 flex items-baseline gap-2">
        <span id="stat-total-blocks" class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight tabular-nums">7</span>
        <span class="text-xs font-semibold text-amber-700 bg-amber-50 border border-amber-200/80 px-2 py-0.5 rounded-md">XML Tags</span>
      </div>
      <span class="text-[11px] text-gray-400 mt-1">&lt;role&gt;, &lt;grounding&gt;, &lt;output&gt;, etc.</span>
    </div>

    <!-- Prefix Caching -->
    <div class="p-4 rounded-2xl bg-white border border-gray-200/80 shadow-xs flex flex-col justify-between hover:border-gray-300 transition-all">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Prefix Caching</span>
        <div class="w-8 h-8 rounded-full border border-gray-200/80 flex items-center justify-center text-emerald-500 bg-emerald-50">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        </div>
      </div>
      <div class="mt-2 flex items-baseline gap-2">
        <span id="stat-prefix-cache" class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">100%</span>
        <span class="text-xs font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200/80 px-2 py-0.5 rounded-md">Byte-Stable</span>
      </div>
      <span class="text-[11px] text-gray-400 mt-1">OpenRouter prompt cache optimized</span>
    </div>

    <!-- Evaluator Status -->
    <div class="p-4 rounded-2xl bg-white border border-gray-200/80 shadow-xs flex flex-col justify-between hover:border-gray-300 transition-all">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Judge / Evaluator</span>
        <div class="w-8 h-8 rounded-full border border-gray-200/80 flex items-center justify-center text-gray-400 bg-gray-50/50">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
      </div>
      <div class="mt-2 flex items-baseline gap-2">
        <span class="text-lg sm:text-xl font-bold text-gray-700">Offline Task</span>
        <span class="text-xs font-semibold text-gray-500 bg-gray-100 border border-gray-200 px-2 py-0.5 rounded-md">Excluded</span>
      </div>
      <span class="text-[11px] text-gray-400 mt-1">Offline RAG judge (non-conversational)</span>
    </div>

  </div>

  <!-- Filters & Search Toolbar -->
  <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4 p-4 rounded-2xl bg-gray-50/70 border border-gray-200/80 shadow-xs">
    
    <!-- Category Filter Pills -->
    <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
      <button data-prompt-cat="all" class="active px-3.5 py-1.5 rounded-full text-xs font-bold text-white bg-gray-900 shadow-xs cursor-pointer transition-all">
        All Prompts (6)
      </button>
      <button data-prompt-cat="core_generation" class="px-3.5 py-1.5 rounded-full text-xs font-semibold text-gray-600 bg-white hover:bg-gray-100 border border-gray-200/80 cursor-pointer transition-all">
        Core Generation (3)
      </button>
      <button data-prompt-cat="memory_summarization" class="px-3.5 py-1.5 rounded-full text-xs font-semibold text-gray-600 bg-white hover:bg-gray-100 border border-gray-200/80 cursor-pointer transition-all">
        Memory & Summarization (2)
      </button>
      <button data-prompt-cat="baseline" class="px-3.5 py-1.5 rounded-full text-xs font-semibold text-gray-600 bg-white hover:bg-gray-100 border border-gray-200/80 cursor-pointer transition-all">
        Baseline Fallback (1)
      </button>
      <button data-prompt-cat="blocks" class="px-3.5 py-1.5 rounded-full text-xs font-semibold text-amber-700 bg-amber-50 hover:bg-amber-100/80 border border-amber-200/80 cursor-pointer transition-all">
        Modular XML Blocks (7)
      </button>
    </div>

    <!-- Search Input -->
    <div class="relative w-full lg:w-72">
      <input
        type="text"
        id="prompt-search-input"
        placeholder="Filter title, Act As, tag..."
        class="w-full text-xs rounded-xl border border-gray-200 bg-white px-3.5 py-2 pl-9 text-gray-800 focus:outline-none focus:border-gray-900 shadow-2xs"
      />
      <svg class="w-4 h-4 text-gray-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
    </div>

  </div>

  <!-- Master-Detail Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

    <!-- Left: Prompt List Selector -->
    <div class="lg:col-span-4 space-y-3">
      <div class="text-[11px] font-bold text-gray-400 uppercase tracking-wider px-1">
        Prompt Inventory
      </div>
      <div id="prompt-items-list" class="space-y-2 max-h-[720px] overflow-y-auto pr-1">
        <div class="p-8 text-center text-xs text-gray-400">Loading prompt inventory...</div>
      </div>
    </div>

    <!-- Right: Detailed Prompt Viewer & Act As Callout -->
    <div class="lg:col-span-8 space-y-4">
      
      <!-- Prompt Viewer Card -->
      <div class="p-5 sm:p-6 rounded-3xl bg-white border border-gray-200/80 shadow-xs space-y-5">
        
        <!-- Header & Action Row -->
        <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 pb-4 border-b border-gray-100">
          <div>
            <h2 id="viewer-prompt-title" class="text-lg sm:text-xl font-extrabold text-gray-900 tracking-tight">Conversational QA Prompt</h2>
            <p id="viewer-prompt-desc" class="text-xs text-gray-500 mt-1 max-w-2xl leading-relaxed">Primary generation prompt for answering factual, policy, SOP, and operational questions.</p>
          </div>
          <button
            id="btn-copy-prompt"
            type="button"
            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold text-gray-700 bg-gray-50 hover:bg-gray-100 border border-gray-200/80 shadow-2xs cursor-pointer transition-all shrink-0 self-start"
            title="Copy prompt text to clipboard"
          >
            <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg>
            <span>Copy Prompt</span>
          </button>
        </div>

        <!-- Prominent ACT AS Callout Banner -->
        <div class="p-4 rounded-2xl bg-gradient-to-r from-blue-50 via-sky-50/50 to-indigo-50/40 border border-blue-200/80 flex items-start gap-3.5">
          <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center shrink-0 shadow-xs">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          </div>
          <div class="min-w-0">
            <div class="text-[10px] font-bold uppercase tracking-wider text-blue-800">Persona & Act-As Role</div>
            <div id="viewer-act-as" class="text-sm sm:text-base font-extrabold text-blue-950 mt-0.5 leading-snug">
              Senior Learning & Development Trainer at Amartha (Digital Learning Team)
            </div>
          </div>
        </div>

        <!-- Metadata Attributes Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <div class="p-3 rounded-xl bg-gray-50/80 border border-gray-100">
            <div class="text-[10px] font-bold uppercase tracking-wider text-gray-400">Tokens Estimate</div>
            <div id="viewer-stat-tokens" class="text-sm font-bold text-gray-800 font-mono mt-0.5">~1850 tok</div>
          </div>
          <div class="p-3 rounded-xl bg-gray-50/80 border border-gray-100">
            <div class="text-[10px] font-bold uppercase tracking-wider text-gray-400">Prefix Cache</div>
            <div id="viewer-stat-cache" class="text-sm font-bold text-emerald-700 mt-0.5">Prefix Cacheable</div>
          </div>
          <div class="p-3 rounded-xl bg-gray-50/80 border border-gray-100 col-span-2 sm:col-span-2">
            <div class="text-[10px] font-bold uppercase tracking-wider text-gray-400">Pipeline Stage</div>
            <div id="viewer-stat-stage" class="text-xs font-semibold text-gray-700 truncate mt-0.5">Production Graph _generate_node</div>
          </div>
        </div>

        <div class="p-3 rounded-xl bg-gray-50/80 border border-gray-100">
          <div class="text-[10px] font-bold uppercase tracking-wider text-gray-400">Intent Trigger</div>
          <div id="viewer-stat-trigger" class="text-xs font-semibold text-gray-800 mt-0.5">KNOWLEDGE • TOPIC_LIST • SECTION_DRILLDOWN</div>
        </div>

        <!-- Components Breakdown -->
        <div>
          <div class="text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-2">Prompt Components / XML Blocks</div>
          <div id="viewer-components-container" class="flex flex-wrap gap-1.5">
            <span class="px-2.5 py-1 rounded-lg bg-gray-100 text-gray-700 border border-gray-200 font-mono text-[11px] font-medium">&lt;role&gt;</span>
            <span class="px-2.5 py-1 rounded-lg bg-gray-100 text-gray-700 border border-gray-200 font-mono text-[11px] font-medium">&lt;output_contract&gt;</span>
            <span class="px-2.5 py-1 rounded-lg bg-gray-100 text-gray-700 border border-gray-200 font-mono text-[11px] font-medium">&lt;grounding&gt;</span>
          </div>
        </div>

        <!-- Raw Content Viewer with Code Block -->
        <div class="space-y-2">
          <div class="flex items-center justify-between text-[11px] font-bold text-gray-400 uppercase tracking-wider">
            <span>System Prompt Content</span>
            <span class="font-mono text-[10px] text-gray-400 lowercase">system_prompt.txt</span>
          </div>
          <div class="relative rounded-2xl bg-gray-900 text-gray-100 p-4 font-mono text-xs overflow-x-auto max-h-[520px] leading-relaxed select-text border border-gray-800">
            <pre id="viewer-prompt-code" class="whitespace-pre-wrap font-mono text-[11px] sm:text-xs text-gray-200">Loading prompt content...</pre>
          </div>
        </div>

      </div>

    </div>

  </div>

</div>
