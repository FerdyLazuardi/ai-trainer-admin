---
// src/components/tabs/ChatLogsTab.astro
interface Props {
  isActive?: boolean;
}
const { isActive = false } = Astro.props;
---

<div id="tab-content-logs" class={`tab-pane ${!isActive ? 'hidden' : ''} space-y-6`}>

  <!-- Sub-Tabs Navigation (Recent Logs | Session Explorer | User LTM | System Prompts) -->
  <div class="flex items-center gap-2 pb-2 border-b border-gray-200/80 overflow-x-auto">
    <button data-log-subtab="recent" class="log-subtab-btn active px-4 py-2 rounded-full text-xs font-bold text-gray-900 bg-white border border-gray-200/80 shadow-xs cursor-pointer transition-all whitespace-nowrap">
      Recent Logs & Overview
    </button>
    <button data-log-subtab="classification" class="log-subtab-btn px-4 py-2 rounded-full text-xs font-semibold text-gray-500 hover:text-gray-900 hover:bg-gray-100 cursor-pointer transition-all whitespace-nowrap">
      Classification
    </button>
    <button data-log-subtab="explorer" class="log-subtab-btn px-4 py-2 rounded-full text-xs font-semibold text-gray-500 hover:text-gray-900 hover:bg-gray-100 cursor-pointer transition-all whitespace-nowrap">
      Session Explorer
    </button>
    <button data-log-subtab="ltm" class="log-subtab-btn px-4 py-2 rounded-full text-xs font-semibold text-gray-500 hover:text-gray-900 hover:bg-gray-100 cursor-pointer transition-all whitespace-nowrap">
      User LTM Profiles
    </button>
    <button id="btn-goto-prompts" type="button" class="ml-auto px-3.5 py-1.5 rounded-full text-xs font-semibold text-blue-600 hover:text-blue-800 hover:bg-blue-50/80 cursor-pointer transition-all flex items-center gap-1.5 shrink-0 whitespace-nowrap">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
      <span>System Prompts</span>
      <span class="text-[10px] font-bold text-blue-600 bg-blue-100/70 px-1.5 py-0.2 rounded-full">5</span>
    </button>
  </div>

  <!-- PANE 1: RECENT LOGS & OVERVIEW -->
  <div id="subtab-pane-recent" class="log-subtab-pane space-y-6">

    <!-- Metrics Row (Vocalyn Clean White Cards) -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      
      <div class="p-4 rounded-2xl bg-white border border-gray-200/80 shadow-xs flex flex-col justify-between hover:border-gray-300 transition-all">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-gray-500">Total Queries</span>
          <div class="w-8 h-8 rounded-full border border-gray-200/80 flex items-center justify-center text-gray-400 bg-gray-50/50">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
          </div>
        </div>
        <div class="mt-2">
          <span id="log-stat-queries" class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight tabular-nums">0</span>
          <span class="text-xs font-medium text-gray-500 ml-2">turns</span>
        </div>
        <span class="text-[11px] text-gray-400 mt-1">Total conversation turns</span>
      </div>

      <div class="p-4 rounded-2xl bg-white border border-gray-200/80 shadow-xs flex flex-col justify-between hover:border-gray-300 transition-all">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-gray-500">Avg. Latency</span>
          <div class="w-8 h-8 rounded-full border border-gray-200/80 flex items-center justify-center text-gray-400 bg-gray-50/50">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
        </div>
        <div class="mt-2">
          <span id="log-stat-latency" class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight tabular-nums">0.0s</span>
          <span class="text-xs font-semibold text-gray-600 bg-gray-100 border border-gray-200 px-2 py-0.5 rounded-md ml-2">p50</span>
        </div>
        <span class="text-[11px] text-gray-400 mt-1">End-to-end response time</span>
      </div>

      <div class="p-4 rounded-2xl bg-white border border-gray-200/80 shadow-xs flex flex-col justify-between hover:border-gray-300 transition-all">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-gray-500">OR Cache Hit Rate</span>
          <div class="w-8 h-8 rounded-full border border-gray-200/80 flex items-center justify-center text-gray-400 bg-gray-50/50">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
        </div>
        <div class="mt-2">
          <span id="log-stat-hitrate" class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight tabular-nums">0%</span>
        </div>
        <span class="text-[11px] text-gray-400 mt-1">Prompt caching efficiency</span>
      </div>

      <div class="p-4 rounded-2xl bg-white border border-gray-200/80 shadow-xs flex flex-col justify-between hover:border-gray-300 transition-all">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-gray-500">Estimated Cost</span>
          <div class="w-8 h-8 rounded-full border border-gray-200/80 flex items-center justify-center text-gray-400 bg-gray-50/50">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
        </div>
        <div class="mt-2">
          <span id="log-stat-cost" class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight tabular-nums">Rp 0</span>
        </div>
        <span id="log-stat-tokens" class="text-[11px] text-gray-400 mt-1">0 cached tokens</span>
      </div>

    </div>

    <!-- Charts Row: Intent Distribution (Donut) & Daily Trends -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      
      <div class="lg:col-span-6 p-5 rounded-3xl bg-gray-50/70 border border-gray-200/80 space-y-3 min-w-0">
        <div class="flex items-center justify-between pb-2 border-b border-gray-200/60">
          <h3 class="text-xs font-bold uppercase tracking-wider text-gray-700">Classification Intent</h3>
        </div>
        <div id="intent-donut-container" class="pt-1 flex items-center justify-center min-h-[260px] overflow-x-auto">
          <div class="text-gray-400 py-6 text-center text-xs">Loading intent donut chart...</div>
        </div>
      </div>

      <div class="lg:col-span-6 p-5 rounded-3xl bg-gray-50/70 border border-gray-200/80 space-y-3 min-w-0 overflow-hidden">
        <div class="flex items-center justify-between pb-2 border-b border-gray-200/60">
          <h3 class="text-xs font-bold uppercase tracking-wider text-gray-700">Daily Request Trends</h3>
          <span class="text-[11px] text-gray-400 font-mono">Last 30 Days</span>
        </div>
        <div class="w-full overflow-x-auto pb-2 -mb-2">
          <div id="trends-chart-container" class="h-48 flex items-end gap-1.5 sm:gap-2 pt-4 pb-2 min-w-[500px] lg:min-w-0 w-full">
            <div class="w-full text-gray-400 text-xs text-center self-center">Loading trend data...</div>
          </div>
        </div>
      </div>

    </div>

    <!-- Chat Logs Table Section -->
    <div class="space-y-4">
      
      <!-- Search & Filter Bar (Vocalyn Exact Match) -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="relative w-full sm:w-80">
          <input
            id="log-search-input"
            type="text"
            placeholder="Search user, point, area, regional, query..."
            class="w-full pl-9 pr-4 py-2.5 rounded-2xl bg-gray-50 border border-gray-200 text-xs text-gray-800 placeholder-gray-400 focus:bg-white focus:outline-none focus:border-gray-400 shadow-xs"
          />
          <svg class="w-4 h-4 text-gray-400 absolute left-3 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </div>

        <div class="flex items-center gap-2">
          <select id="log-intent-filter" class="px-3.5 py-2 rounded-2xl bg-white border border-gray-200 text-xs font-semibold text-gray-700 focus:outline-none shadow-xs cursor-pointer">
            <option value="ALL">All Intents</option>
            <option value="KNOWLEDGE">KNOWLEDGE</option>
            <option value="COACHING">COACHING</option>
            <option value="GREETING">GREETING</option>
            <option value="OFF_SCOPE">OFF_SCOPE</option>
            <option value="TOPIC_LIST">TOPIC_LIST</option>
            <option value="AMBIGUOUS">AMBIGUOUS</option>
            <option value="SECTION_DRILLDOWN">SECTION_DRILLDOWN</option>
          </select>
          <button
            id="btn-export-logs-csv"
            type="button"
            class="px-3.5 py-2 rounded-2xl bg-gray-900 hover:bg-black text-white text-xs font-semibold shadow-xs cursor-pointer transition-all flex items-center gap-1.5 whitespace-nowrap"
            title="Export filtered logs with Point, Area, Regional, Pulau to CSV"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
            <span>Export CSV</span>
          </button>
        </div>
      </div>

      <!-- Table -->
      <div class="rounded-3xl border border-gray-200/80 overflow-hidden shadow-xs">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-gray-50/80 border-b border-gray-200/80 text-gray-400 uppercase text-[10px] font-bold tracking-wider">
              <tr>
                <th class="py-3.5 px-4 w-32">Time (WIB)</th>
                <th class="py-3.5 px-4 w-44">User / Role</th>
                <th class="py-3.5 px-4">Query & Response</th>
                <th class="py-3.5 px-4 w-28">Intent</th>
                <th class="py-3.5 px-4 w-20">Latency</th>
                <th class="py-3.5 px-4 w-20">Tokens</th>
                <th class="py-3.5 px-4 text-right w-20">Cost (IDR)</th>
              </tr>
            </thead>
            <tbody id="chat-logs-rows" class="divide-y divide-gray-100 bg-white text-gray-700">
              <tr><td colspan="7" class="py-8 text-center text-gray-400">Loading chat logs...</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Pagination Controls for Chat Logs -->
      <div class="flex items-center justify-between pt-2 text-xs text-gray-500 font-sans">
        <span id="log-page-indicator">Showing records</span>
        
        <div class="flex items-center gap-1.5 font-semibold">
          <button id="btn-log-prev" class="w-8 h-8 rounded-xl border border-gray-200 bg-white text-gray-600 hover:bg-gray-50 flex items-center justify-center disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer shadow-xs">
            ‹
          </button>
          <span id="log-current-page" class="w-8 h-8 rounded-xl bg-gray-900 text-white text-xs flex items-center justify-center font-bold">1</span>
          <button id="btn-log-next" class="w-8 h-8 rounded-xl border border-gray-200 bg-white text-gray-600 hover:bg-gray-50 flex items-center justify-center disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer shadow-xs">
            ›
          </button>
        </div>
      </div>

    </div>

  </div>

  <!-- PANE: CLASSIFICATION & REGIONAL ANALYTICS -->
  <div id="subtab-pane-classification" class="log-subtab-pane hidden space-y-6">

    <!-- Top Metrics Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="p-4 rounded-2xl bg-white border border-gray-200/80 shadow-xs flex flex-col justify-between hover:border-gray-300 transition-all">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-gray-500">Total Turn</span>
          <div class="w-8 h-8 rounded-full border border-gray-200/80 flex items-center justify-center text-gray-400 bg-gray-50/50">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"/></svg>
          </div>
        </div>
        <div class="mt-2">
          <span id="class-stat-total-queries" class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight tabular-nums">0</span>
          <span class="text-xs font-medium text-gray-500 ml-2">turns</span>
        </div>
      </div>

      <div class="p-4 rounded-2xl bg-white border border-gray-200/80 shadow-xs flex flex-col justify-between hover:border-gray-300 transition-all">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-gray-500">Top Topic</span>
          <div class="w-8 h-8 rounded-full border border-gray-200/80 flex items-center justify-center text-gray-400 bg-gray-50/50">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
          </div>
        </div>
        <div class="mt-2 truncate">
          <span id="class-stat-top-category" class="text-base font-extrabold text-gray-900 tracking-tight truncate block" title="-">—</span>
          <span id="class-stat-top-pct" class="text-xs font-semibold text-gray-700 bg-gray-100 border border-gray-200 px-2 py-0.5 rounded-md mt-1 inline-block">0%</span>
        </div>
      </div>

      <div class="p-4 rounded-2xl bg-white border border-gray-200/80 shadow-xs flex flex-col justify-between hover:border-gray-300 transition-all">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-gray-500">Position</span>
          <div class="w-8 h-8 rounded-full border border-gray-200/80 flex items-center justify-center text-gray-400 bg-gray-50/50">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          </div>
        </div>
        <div class="mt-2 truncate">
          <span id="class-stat-top-position" class="text-base font-extrabold text-gray-900 tracking-tight truncate block" title="-">—</span>
          <span id="class-stat-top-position-pct" class="text-xs font-semibold text-gray-700 bg-gray-100 border border-gray-200 px-2 py-0.5 rounded-md mt-1 inline-block">0%</span>
        </div>
      </div>
    </div>

    <!-- Filters & Action Bar -->
    <div class="p-4 rounded-2xl bg-white border border-gray-200/80 shadow-xs space-y-3">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3">
        <div>
          <h4 class="text-xs font-bold uppercase tracking-wider text-gray-900 flex items-center gap-2">
            <span>Query Classification & Regional Distribution</span>
          </h4>
          <p class="text-[11px] text-gray-400 mt-0.5">Filter queries by pulau, region, area, branch point, position, account type, or keyword.</p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <button id="btn-reset-class-filters" type="button" class="px-3 py-1.5 rounded-xl border border-gray-200 bg-white hover:bg-gray-50 text-xs font-semibold text-gray-600 shadow-2xs cursor-pointer transition-all">
            Reset Filters
          </button>
          <button id="btn-export-classification-csv" type="button" class="px-3.5 py-1.5 rounded-xl bg-gray-900 hover:bg-black text-white text-xs font-semibold shadow-xs cursor-pointer transition-all flex items-center gap-1.5 whitespace-nowrap">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
            <span>Export Classification CSV</span>
          </button>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-2.5 pt-1">
        <div>
          <label class="block text-[10px] font-bold uppercase tracking-wider text-gray-400 mb-1">Pulau</label>
          <select id="class-filter-pulau" class="w-full px-2.5 py-1.5 rounded-xl bg-gray-50 border border-gray-200 text-xs font-semibold text-gray-800 focus:bg-white focus:outline-none cursor-pointer">
            <option value="ALL">All Pulau</option>
          </select>
        </div>
        <div>
          <label class="block text-[10px] font-bold uppercase tracking-wider text-gray-400 mb-1">Region</label>
          <select id="class-filter-regional" class="w-full px-2.5 py-1.5 rounded-xl bg-gray-50 border border-gray-200 text-xs font-semibold text-gray-800 focus:bg-white focus:outline-none cursor-pointer">
            <option value="ALL">All Regions</option>
          </select>
        </div>
        <div>
          <label class="block text-[10px] font-bold uppercase tracking-wider text-gray-400 mb-1">Area</label>
          <select id="class-filter-area" class="w-full px-2.5 py-1.5 rounded-xl bg-gray-50 border border-gray-200 text-xs font-semibold text-gray-800 focus:bg-white focus:outline-none cursor-pointer">
            <option value="ALL">All Areas</option>
          </select>
        </div>
        <div>
          <label class="block text-[10px] font-bold uppercase tracking-wider text-gray-400 mb-1">Branch Point</label>
          <select id="class-filter-point" class="w-full px-2.5 py-1.5 rounded-xl bg-gray-50 border border-gray-200 text-xs font-semibold text-gray-800 focus:bg-white focus:outline-none cursor-pointer">
            <option value="ALL">All Branch Points</option>
          </select>
        </div>
        <div>
          <label class="block text-[10px] font-bold uppercase tracking-wider text-gray-400 mb-1">Position</label>
          <select id="class-filter-position" class="w-full px-2.5 py-1.5 rounded-xl bg-gray-50 border border-gray-200 text-xs font-semibold text-gray-800 focus:bg-white focus:outline-none cursor-pointer">
            <option value="ALL">All Positions</option>
          </select>
        </div>
        <div>
          <label class="block text-[10px] font-bold uppercase tracking-wider text-gray-400 mb-1">Account Type</label>
          <select id="class-filter-account" class="w-full px-2.5 py-1.5 rounded-xl bg-gray-50 border border-gray-200 text-xs font-semibold text-gray-800 focus:bg-white focus:outline-none cursor-pointer">
            <option value="REAL" selected>Real Accounts (User ID &gt; 20)</option>
            <option value="ALL">All Accounts (Including Testing)</option>
            <option value="TESTING">Test Accounts (User ID &le; 20)</option>
          </select>
        </div>
        <div class="col-span-2 sm:col-span-2 lg:col-span-1">
          <label class="block text-[10px] font-bold uppercase tracking-wider text-gray-400 mb-1">Search Query / Keyword</label>
          <div class="relative">
            <input id="class-filter-search" type="text" placeholder="Search queries, topics..." class="w-full pl-8 pr-3 py-1.5 rounded-xl bg-gray-50 border border-gray-200 text-xs text-gray-800 placeholder-gray-400 focus:bg-white focus:outline-none" />
            <svg class="w-3.5 h-3.5 text-gray-400 absolute left-2.5 top-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Table: Domain Categories & Verbatim Queries (Moved to Top) -->
    <div class="rounded-3xl border border-gray-200/80 overflow-hidden shadow-xs bg-white">
      <div class="p-4 sm:p-5 border-b border-gray-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <h3 class="text-sm font-bold text-gray-900">Domain Classification & Verbatim Queries</h3>
          <p class="text-xs text-gray-400 mt-0.5">Click expand on any category to view all raw field queries and asker distribution</p>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold text-gray-500 font-mono" id="class-table-summary-count">11 Topic Domains</span>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-gray-50/80 border-b border-gray-200/80 text-gray-400 uppercase text-[10px] font-bold tracking-wider">
            <tr>
              <th class="py-3 px-4 w-12 text-center">#</th>
              <th class="py-3 px-4">Classification & Field Subtopics</th>
              <th class="py-3 px-4 w-28 text-right">Frequency</th>
              <th class="py-3 px-4 w-24 text-right">% Total</th>
              <th class="py-3 px-4 w-44">Pulau Distribution</th>
              <th class="py-3 px-4 w-48">Position Distribution</th>
              <th class="py-3 px-4 w-28 text-center">Action</th>
            </tr>
          </thead>
          <tbody id="classification-table-rows" class="divide-y divide-gray-100 text-gray-700">
            <tr><td colspan="7" class="py-8 text-center text-gray-400">Loading classification records...</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Geo Distribution Breakdown Row (Moved Below Table) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
      <!-- Card: Sebaran Asal Berdasarkan Pulau & Regional -->
      <div class="p-5 rounded-3xl bg-white border border-gray-200/80 shadow-xs space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-gray-900">Geographic Distribution: Pulau & Region</h4>
            <p class="text-[11px] text-gray-400">Field query distribution across Indonesian islands and operational regions</p>
          </div>
          <!-- Percentage Tier Color Legend (Acuan User) -->
          <div class="flex items-center gap-2 text-[10px] font-mono text-gray-500 font-medium shrink-0 flex-wrap">
