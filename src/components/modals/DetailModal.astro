---
// Detail Dialog Modal
---
<dialog id="detail-modal" class="fixed inset-0 m-auto z-50 max-w-5xl lg:max-w-6xl w-[96vw] rounded-3xl bg-white border border-gray-200 text-gray-900 p-0 shadow-2xl backdrop:bg-black/40 backdrop:backdrop-blur-xs">
  <div class="p-6 sm:p-8 space-y-5">
    <div class="flex items-center justify-between pb-4 border-b border-gray-100">
      <div>
        <h3 id="modal-title" class="text-lg font-bold text-gray-900">Detail View</h3>
        <p id="modal-subtitle" class="text-xs text-gray-500 mt-0.5">Record details</p>
      </div>
      <button id="modal-close" type="button" aria-label="Close detail view" class="w-11 h-11 sm:w-9 sm:h-9 flex items-center justify-center text-gray-500 hover:text-gray-800 rounded-lg hover:bg-gray-100 transition-colors cursor-pointer">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div id="modal-content" class="max-h-[75vh] overflow-y-auto pr-1 space-y-4 text-sm font-sans">
      <!-- Injected via JavaScript -->
    </div>
  </div>
</dialog>
