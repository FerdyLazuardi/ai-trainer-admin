---
// src/components/modals/ConfirmSignOutModal.astro
// Confirmation modal before signing out
---

<dialog id="confirm-signout-modal" class="fixed inset-0 m-auto z-50 max-w-md w-[92vw] rounded-3xl bg-white border border-gray-200 text-gray-900 p-0 shadow-2xl backdrop:bg-black/40 backdrop:backdrop-blur-xs">
  <div class="p-6 sm:p-7 space-y-5">
    <div class="flex items-start gap-4">
      <div class="w-11 h-11 rounded-2xl bg-gray-100 border border-gray-200 flex items-center justify-center text-gray-700 shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
        </svg>
      </div>
      <div class="min-w-0 flex-1">
        <h3 class="text-base font-bold text-gray-900 leading-tight">Sign Out</h3>
        <p class="text-xs text-gray-500 mt-1 leading-relaxed">
          Are you sure you want to end your session and sign out of Dashboard Ai Trainer?
        </p>
      </div>
    </div>

    <div class="flex items-center justify-end gap-2.5 pt-3 border-t border-gray-100">
      <button id="btn-cancel-signout" type="button" class="px-4 py-2.5 rounded-2xl border border-gray-200 bg-white hover:bg-gray-50 active:bg-gray-100 text-xs font-semibold text-gray-700 cursor-pointer transition-colors">
        Cancel
      </button>
      <a href="/api/auth/logout" id="btn-confirm-signout" class="px-5 py-2.5 rounded-2xl bg-gray-900 hover:bg-black active:scale-[0.99] text-xs font-semibold text-white shadow-xs cursor-pointer inline-flex items-center gap-2 transition-all">
        Sign Out
      </a>
    </div>
  </div>
</dialog>

<script>
  const signoutModal = document.getElementById('confirm-signout-modal') as HTMLDialogElement | null;
  const cancelBtn = document.getElementById('btn-cancel-signout');

  // Cancel action
  if (cancelBtn && signoutModal) {
    cancelBtn.addEventListener('click', () => {
      signoutModal.close();
    });
  }

  // Close when clicking outside backdrop
  if (signoutModal) {
    signoutModal.addEventListener('click', (e) => {
      if (e.target === signoutModal) {
        signoutModal.close();
      }
    });
  }

  // Global function to trigger sign out confirmation
  (window as any).openSignOutModal = () => {
    if (signoutModal) {
      signoutModal.showModal();
    }
  };

  // Bind to sidebar logout button
  document.addEventListener('DOMContentLoaded', () => {
    const logoutBtn = document.getElementById('btn-sidebar-logout');
    if (logoutBtn) {
      logoutBtn.addEventListener('click', (e) => {
        e.preventDefault();
        (window as any).openSignOutModal();
      });
    }
  });
</script>
