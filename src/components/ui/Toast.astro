---
// Toast Notification Overlay
---
<div id="toast" role="status" aria-live="polite" class="fixed bottom-6 right-6 z-50 transform transition-all duration-200 translate-y-12 opacity-0 pointer-events-none">
  <div id="toast-body" class="px-4 py-3 rounded-xl border border-gray-200/80 bg-white text-xs font-medium shadow-xl flex items-center gap-2.5 text-gray-900">
    <span id="toast-icon" class="inline-flex items-center justify-center shrink-0 text-emerald-600" aria-hidden="true">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
    </span>
    <span id="toast-msg">Done</span>
  </div>
</div>
