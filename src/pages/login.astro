---
// src/pages/login.astro
import '../styles/global.css';

const errorParam = Astro.url.searchParams.get('error');
const logoutParam = Astro.url.searchParams.get('logout');

let noticeMessage = '';
let isError = false;

if (errorParam === 'invalid_domain') {
  noticeMessage = 'Access Restricted: Only @amartha.com accounts are permitted to sign in.';
  isError = true;
} else if (errorParam === 'missing_credentials') {
  noticeMessage = 'Setup Required: Google OAuth credentials have not been configured yet.';
  isError = true;
} else if (errorParam === 'token_exchange_failed' || errorParam === 'userinfo_failed') {
  noticeMessage = 'Authentication failed. Please verify your connection and try again.';
  isError = true;
} else if (errorParam) {
  noticeMessage = `Unable to sign in: ${errorParam}`;
  isError = true;
} else if (logoutParam === '1') {
  noticeMessage = 'You have been successfully signed out.';
  isError = false;
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign In • Dashboard Ai Trainer</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon.png" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
</head>
<body class="bg-[#F3F4F6] text-gray-900 min-h-screen flex items-center justify-center p-4 antialiased selection:bg-gray-900/10 selection:text-gray-900 font-sans">
  
  <div class="w-full max-w-sm sm:max-w-md">
    <!-- Main Login Card -->
    <div class="bg-white rounded-3xl border border-gray-200/80 shadow-sm p-6 sm:p-9 flex flex-col items-center text-center">
      
      <!-- Brand & Product Identity -->
      <div class="mb-4 flex flex-col items-center">
        <img src="/amartha.svg" alt="Amartha" class="h-8 w-auto object-contain" />
      </div>

      <!-- Title & Headline -->
      <h1 class="text-xl sm:text-2xl font-extrabold text-gray-900 tracking-tight leading-tight mb-2">
        Dashboard Ai Trainer
      </h1>
      <p class="text-xs text-gray-500 mb-6 leading-relaxed max-w-xs">
        Sign in with your corporate account to access synchronized telemetry, analytics, and knowledge systems.
      </p>

      <!-- Context Notice / Error Banner -->
      {noticeMessage && (
        <div class={`w-full mb-6 p-3.5 rounded-2xl text-xs text-left leading-relaxed ${
          isError 
            ? 'bg-rose-50 border border-rose-200 text-rose-800' 
            : 'bg-emerald-50 border border-emerald-200 text-emerald-800'
        }`}>
          {noticeMessage}
        </div>
      )}

      <!-- Primary Action: Google Single Sign-On (White Elegant Button) -->
      <a
        href="/api/auth/login"
        class="w-full inline-flex items-center justify-center gap-3 px-5 py-3 rounded-full bg-white hover:bg-gray-50/90 active:scale-[0.99] text-gray-800 border border-gray-200/90 hover:border-gray-300 text-xs font-semibold transition-all shadow-xs cursor-pointer group"
      >
        <!-- Standard Google G Logo -->
        <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
        </svg>
        <span>Sign in with Google</span>
      </a>

      <!-- Domain Policy Footnote -->
      <div class="mt-6 pt-5 border-t border-gray-100 w-full flex flex-col items-center gap-1.5 text-center">
        <span class="text-[11px] font-medium text-gray-400">
          Domain Restricted Access
        </span>
        <span class="text-[11px] text-gray-500 font-mono bg-gray-50 border border-gray-200/60 px-2 py-0.5 rounded-lg">
          @amartha.com
        </span>
      </div>

    </div>
  </div>

</body>
</html>
