---
// src/pages/index.astro
import '../styles/global.css';
import { AUTH_SECRET } from 'astro:env/server';
import { verifySession, SESSION_COOKIE_NAME } from '../lib/auth';

// Layout & UI Components
import Toast from '../components/ui/Toast.astro';
import MobileNavbar from '../components/layout/MobileNavbar.astro';
import Sidebar from '../components/layout/Sidebar.astro';
import Header from '../components/layout/Header.astro';

// Modals
import DetailModal from '../components/modals/DetailModal.astro';
import ThreadModal from '../components/modals/ThreadModal.astro';
import ConfirmDeleteModal from '../components/modals/ConfirmDeleteModal.astro';
import UserManagementModal from '../components/modals/UserManagementModal.astro';
import ConfirmSignOutModal from '../components/modals/ConfirmSignOutModal.astro';

// Feature Tabs
import SpreadsheetSyncTab from '../components/tabs/SpreadsheetSyncTab.astro';
import ConvertIngestTab from '../components/tabs/ConvertIngestTab.astro';
import ChatLogsTab from '../components/tabs/ChatLogsTab.astro';
import SpreadsheetKpiTab from '../components/tabs/SpreadsheetKpiTab.astro';
import ActiveKnowledgeTab from '../components/tabs/ActiveKnowledgeTab.astro';
import SystemPromptsTab from '../components/tabs/SystemPromptsTab.astro';

// Authenticate session from middleware or cookie
const authSecret = AUTH_SECRET || (process.env.AUTH_SECRET ?? 'amartha_cag_secret_session_token_key_2026');
const cookieVal = Astro.cookies.get(SESSION_COOKIE_NAME)?.value;
const user = (Astro.locals as any).user || (await verifySession(cookieVal, authSecret));

if (!user || user.status !== 'APPROVED') {
  return Astro.redirect('/login');
}

const userEmail = user.email;
const userName = user.name || userEmail.split('@')[0];
const userRole = user.role || 'MEMBER';
const isAdmin = userRole === 'ADMIN';

const initialTitle = isAdmin ? 'Spreadsheet Sync' : 'Chat Logs & Analytics';
const initialSubtitle = isAdmin
  ? 'Automated synchronization and telemetry management'
  : 'Audited turns, intent distribution, and LLM telemetry';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard Ai - Trainer • Operations & Analytics Cockpit</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon.png" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <script is:inline src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>
</head>
<body class="bg-[#F3F4F6] text-gray-900 min-h-screen lg:h-screen lg:overflow-hidden antialiased p-0 lg:p-5 flex flex-col lg:flex-row gap-0 lg:gap-5 font-sans selection:bg-gray-900/10 selection:text-gray-900">

  <!-- Mobile Sticky Top Navbar & Backdrop -->
  <MobileNavbar initialTitle={initialTitle} />

  <!-- Toast Notification Overlay -->
  <Toast />

  <!-- Modals -->
  <DetailModal />
  <ThreadModal />
  <ConfirmDeleteModal />
  <ConfirmSignOutModal />
  {isAdmin && <UserManagementModal />}

  <!-- Left Navigation Sidebar -->
  <Sidebar userRole={userRole} userEmail={userEmail} userName={userName} />

  <!-- Main Content Canvas -->
  <main class="flex-1 bg-white lg:rounded-3xl border-t lg:border border-gray-200/80 shadow-sm p-4 sm:p-6 lg:p-8 flex flex-col gap-6 lg:h-full lg:overflow-y-auto min-w-0 m-2 sm:m-3 lg:m-0 rounded-2xl">
    <!-- Top Header -->
    <Header initialTitle={initialTitle} initialSubtitle={initialSubtitle} />

    <!-- Feature Tab Panels: Ingestion tabs only accessible to Admins -->
    {isAdmin && (
      <>
        <SpreadsheetSyncTab />
        <ConvertIngestTab />
      </>
    )}
    <ChatLogsTab isActive={!isAdmin} />
    <SpreadsheetKpiTab />
    <ActiveKnowledgeTab />
    <SystemPromptsTab />
  </main>

  <!-- Client-side Logic Script (Vite bundled TypeScript) -->
  <script src="../scripts/main.ts"></script>
</body>
</html>
