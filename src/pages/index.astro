---
import '../styles/global.css';

// Read Cloudflare Zero Trust authenticated identity if available
const userEmail = Astro.request.headers.get('cf-access-authenticated-user-email') || 'operator@amartha.com';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard Ai - Trainer • Operations & Analytics Cockpit</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon.png" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
</head>
<body class="bg-[#F3F4F6] text-gray-900 min-h-screen lg:h-screen lg:overflow-hidden antialiased p-0 lg:p-5 flex flex-col lg:flex-row gap-0 lg:gap-5 font-sans selection:bg-gray-900/10 selection:text-gray-900">

  <!-- Mobile Sticky Top Navbar (sticky and follows user on scroll) -->
  <header id="mobile-navbar" class="lg:hidden sticky top-0 z-40 w-full bg-white/95 backdrop-blur-md border-b border-gray-200/80 px-4 py-3 flex items-center justify-between">
    <div class="flex items-center gap-3 min-w-0">
      <button id="mobile-menu-toggle" title="Open Navigation Menu" class="w-8 h-8 rounded-xl border border-gray-200/90 bg-white hover:bg-gray-50 active:bg-gray-100 text-gray-700 flex items-center justify-center cursor-pointer transition-all shrink-0">
        <svg id="mobile-menu-arrow" class="w-4 h-4 transition-transform duration-200 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <div class="min-w-0">
        <div id="mobile-header-title" class="font-extrabold text-sm text-gray-900 tracking-tight leading-tight">Spreadsheet Sync</div>
        <div class="font-bold text-[10px] text-gray-500 tracking-wide leading-tight mt-0.5">Ai - Trainer</div>
      </div>
    </div>
  </header>

  <!-- Mobile Backdrop Overlay -->
  <div id="mobile-sidebar-backdrop" class="fixed inset-0 bg-black/40 backdrop-blur-xs z-40 hidden lg:hidden transition-opacity duration-300"></div>

  <!-- Toast Notification Overlay -->
  <div id="toast" class="fixed bottom-6 right-6 z-50 transform transition-all duration-200 translate-y-12 opacity-0 pointer-events-none">
    <div id="toast-body" class="px-4 py-3 rounded-2xl border border-gray-200/80 bg-white text-xs font-mono shadow-xl backdrop-blur-md flex items-center gap-2.5 text-gray-900">
      <span id="toast-icon">⚡</span>
      <span id="toast-msg">Operation completed</span>
    </div>
  </div>

  <!-- Detail Dialog Modal (Clean White Vocalyn Style) -->
  <dialog id="detail-modal" class="fixed inset-0 m-auto z-50 max-w-2xl w-[92vw] rounded-3xl bg-white border border-gray-200 text-gray-900 p-0 shadow-2xl backdrop:bg-black/40 backdrop:backdrop-blur-xs">
    <div class="p-6 sm:p-8 space-y-5">
      <div class="flex items-center justify-between pb-4 border-b border-gray-100">
        <div>
          <h3 id="modal-title" class="text-lg font-bold text-gray-900">Detail View</h3>
          <p id="modal-subtitle" class="text-xs text-gray-400 mt-0.5">Comprehensive metadata record</p>
        </div>
        <button id="modal-close" class="text-gray-400 hover:text-gray-700 p-2 rounded-xl hover:bg-gray-100 transition-colors cursor-pointer">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <div id="modal-content" class="max-h-[68vh] overflow-y-auto pr-1 space-y-4 text-sm font-sans">
        <!-- Injected via JavaScript -->
      </div>
    </div>
  </dialog>

  <!-- Session Chat Thread Dialog Modal -->
  <dialog id="thread-modal" class="fixed inset-0 m-auto z-50 max-w-3xl w-[94vw] rounded-3xl bg-white border border-gray-200 text-gray-900 p-0 shadow-2xl backdrop:bg-black/40 backdrop:backdrop-blur-xs">
    <div class="p-6 sm:p-8 space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-gray-100">
        <div>
          <h3 id="thread-session-title" class="text-base font-bold text-gray-900">Conversation History</h3>
          <p id="thread-session-subtitle" class="text-xs text-gray-400 font-mono mt-0.5">Session ID: —</p>
        </div>
        <button id="btn-close-thread-modal" class="text-gray-400 hover:text-gray-700 p-2 rounded-xl hover:bg-gray-100 transition-colors cursor-pointer">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <div id="thread-messages-list" class="space-y-4 max-h-[70vh] overflow-y-auto pr-2">
        <!-- Rendered chat bubbles -->
      </div>
    </div>
  </dialog>

  <!-- Confirm Delete All KPI Dialog Modal (Clean Vocalyn Style) -->
  <dialog id="confirm-delete-kpi-modal" class="fixed inset-0 m-auto z-50 max-w-md w-[92vw] rounded-3xl bg-white border border-gray-200 text-gray-900 p-0 shadow-2xl backdrop:bg-black/40 backdrop:backdrop-blur-xs">
    <div class="p-6 sm:p-7 space-y-5">
      <div class="flex items-start gap-4">
        <div class="w-11 h-11 rounded-2xl bg-rose-50 border border-rose-100 flex items-center justify-center text-rose-600 shrink-0">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <h3 class="text-base font-bold text-gray-900 leading-tight">Truncate Database KPI?</h3>
          <p class="text-xs text-gray-500 mt-1 leading-relaxed">
            This action will permanently wipe all records from <code class="px-1.5 py-0.5 rounded bg-gray-100 font-mono text-gray-800 text-[11px]">user_kpi_data</code> and <code class="px-1.5 py-0.5 rounded bg-gray-100 font-mono text-gray-800 text-[11px]">branch_data</code> in PostgreSQL.
          </p>
        </div>
      </div>

      <div class="p-3 rounded-2xl bg-amber-50/70 border border-amber-200/80 text-[11px] text-amber-900 flex items-start gap-2">
        <span class="text-base leading-none">⚠️</span>
        <div>
          <span class="font-bold">Proxmox Command:</span><br>
          <code class="font-mono text-[10px] text-amber-950 break-all">TRUNCATE TABLE user_kpi_data, branch_data RESTART IDENTITY;</code>
        </div>
      </div>

      <div class="flex items-center justify-end gap-2.5 pt-2">
        <button id="btn-cancel-delete-kpi" type="button" class="px-4 py-2.5 rounded-2xl border border-gray-200 bg-white hover:bg-gray-50 active:bg-gray-100 text-xs font-semibold text-gray-700 cursor-pointer transition-colors">
          Cancel
        </button>
        <button id="btn-confirm-delete-kpi" type="button" class="px-4 py-2.5 rounded-2xl bg-rose-600 hover:bg-rose-700 active:bg-rose-800 text-xs font-semibold text-white shadow-xs cursor-pointer flex items-center gap-2 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
          <span id="confirm-delete-btn-text">Yes, Delete All Data</span>
        </button>
      </div>
    </div>
  </dialog>

  <!-- Left Sidebar (Vocalyn Exact Match on Desktop + Slide-Over Drawer on Mobile) -->
  <aside id="main-sidebar" class="w-72 lg:w-64 h-full bg-[#F3F4F6] shrink-0 flex flex-col justify-between py-4 lg:py-2 px-3 lg:px-1 select-none space-y-6 transition-[width] duration-200 overflow-y-auto">
    <div class="space-y-6">
      
      <!-- Brand & Product Title & Collapse / Mobile Close Toggle -->
      <div class="sidebar-header flex items-center justify-between px-3">
        <div class="sidebar-brand-logo sidebar-text min-w-0">
          <div class="font-extrabold text-base text-gray-900 tracking-tight leading-tight">Dashboard</div>
          <div class="font-bold text-xs text-gray-500 tracking-wide leading-tight mt-0.5">Ai - Trainer</div>
        </div>

        <!-- Desktop Collapse Button -->
        <button id="sidebar-toggle-btn" title="Toggle Sidebar" class="hidden lg:flex w-7 h-7 rounded-lg border border-gray-200/80 bg-white/80 hover:bg-white text-gray-500 hover:text-gray-900 items-center justify-center cursor-pointer transition-all shrink-0 shadow-2xs">
          <svg id="sidebar-toggle-icon" class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        </button>

        <!-- Mobile Close Button inside Drawer -->
        <button id="mobile-sidebar-close" title="Close Menu" class="lg:hidden w-8 h-8 rounded-xl border border-gray-200/80 bg-white text-gray-500 hover:text-gray-900 flex items-center justify-center cursor-pointer shadow-2xs">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <!-- Navigation Tabs (Categorized & Pill Style) -->
      <nav class="space-y-5 px-1">
        <div>
          <div class="sidebar-text text-[10px] font-bold text-gray-400 uppercase tracking-wider px-3 mb-2">Ingestion</div>
          <ul class="space-y-1">
            <li>
              <button data-tab="sync" title="Spreadsheet Sync" class="tab-btn active w-full flex items-center gap-3 px-4 py-2.5 rounded-full text-xs font-semibold text-gray-900 bg-white shadow-xs cursor-pointer transition-all">
                <svg class="w-4 h-4 text-gray-900 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                <span class="sidebar-text truncate">Spreadsheet Sync</span>
              </button>
            </li>
          </ul>
        </div>

        <div>
          <div class="sidebar-text text-[10px] font-bold text-gray-400 uppercase tracking-wider px-3 mb-2">Analytics</div>
          <ul class="space-y-1">
            <li>
              <button data-tab="logs" title="Chat Logs" class="tab-btn w-full flex items-center gap-3 px-4 py-2.5 rounded-full text-xs font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-200/60 cursor-pointer transition-all">
                <svg class="w-4 h-4 text-gray-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                <span class="sidebar-text truncate">Chat Logs</span>
              </button>
            </li>
            <li>
              <button data-tab="kpi" title="Spreadsheet KPI" class="tab-btn w-full flex items-center gap-3 px-4 py-2.5 rounded-full text-xs font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-200/60 cursor-pointer transition-all">
                <svg class="w-4 h-4 text-gray-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                <span class="sidebar-text truncate">Spreadsheet KPI</span>
              </button>
            </li>
          </ul>
        </div>
      </nav>

    </div>
  </aside>

  <!-- Main Content Canvas (Pure White Vocalyn Panel) -->
  <main class="flex-1 bg-white lg:rounded-3xl border-t lg:border border-gray-200/80 shadow-sm p-4 sm:p-6 lg:p-8 flex flex-col gap-6 lg:h-full lg:overflow-y-auto min-w-0 m-2 sm:m-3 lg:m-0 rounded-2xl">

    <!-- Top Canvas Header -->
    <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2">
      <div>
        <h1 id="page-title" class="text-2xl font-extrabold text-gray-900 tracking-tight">Spreadsheet Sync</h1>
        <p id="page-subtitle" class="text-xs text-gray-400 mt-0.5">Automated synchronization and telemetry management</p>
      </div>

      <!-- Top Tools & Badges -->
      <div class="flex items-center gap-3">
        <div id="wib-clock" class="text-xs font-mono font-medium px-3 py-1.5 rounded-xl bg-gray-50 border border-gray-200/80 text-gray-600 tabular-nums">
          00:00:00 WIB
        </div>

        <button id="btn-refresh-all" class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-white hover:bg-gray-50 border border-gray-200/80 text-xs font-semibold text-gray-700 shadow-xs transition-colors cursor-pointer">
          <svg class="w-3.5 h-3.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          <span>Refresh</span>
        </button>
      </div>
    </header>

    <!-- ========================================== -->
    <!-- TAB 1: SPREADSHEET SYNC -->
    <!-- ========================================== -->
    <div id="tab-content-sync" class="tab-pane space-y-6">

      <!-- Top Metric Cards (5 Columns like Vocalyn) -->
      <!-- Top Metric Cards (3 Columns) -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        
        <!-- Highlighted Total KPI Records Card -->
        <div class="p-4 rounded-2xl bg-emerald-50/60 border-2 border-emerald-600 shadow-xs flex flex-col justify-between hover:shadow-md transition-all relative overflow-hidden group">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-emerald-700 uppercase tracking-wider">Total KPI Records</span>
            <div class="w-8 h-8 rounded-full border border-emerald-600/30 flex items-center justify-center text-emerald-700 bg-white shadow-2xs">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
            </div>
          </div>
          <div class="mt-2">
            <span id="stat-user-count" class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight tabular-nums">-</span>
            <span class="text-xs font-semibold text-emerald-700 bg-emerald-100/80 border border-emerald-200 px-2 py-0.5 rounded-md ml-2 inline-flex items-center gap-0.5">Postgres</span>
          </div>
          <span class="text-[11px] text-gray-500 mt-1 font-medium">Synced to table: user_kpi_data</span>
        </div>

        <div class="p-4 rounded-2xl bg-white border border-gray-200/80 shadow-xs flex flex-col justify-between hover:border-gray-300 transition-all">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-gray-500">Auto-Sync Cadence</span>
            <div class="w-8 h-8 rounded-full border border-gray-200/80 flex items-center justify-center text-gray-400 bg-gray-50/50">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
          </div>
          <div class="mt-2">
            <span id="stat-cadence-badge" class="text-base font-bold text-gray-900">Loading...</span>
          </div>
          <span id="stat-cadence-detail" class="text-[11px] text-gray-400 mt-1">Streaq worker hourly cron</span>
        </div>

        <div class="p-4 rounded-2xl bg-white border border-gray-200/80 shadow-xs flex flex-col justify-between hover:border-gray-300 transition-all">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-gray-500">Last Execution</span>
            <div class="w-8 h-8 rounded-full border border-gray-200/80 flex items-center justify-center text-gray-400 bg-gray-50/50">
              <span id="stat-status-dot" class="w-2.5 h-2.5 rounded-full bg-gray-400"></span>
            </div>
          </div>
          <div class="mt-2">
            <span id="stat-status-text" class="text-base font-bold text-gray-900">—</span>
          </div>
          <span id="stat-last-time" class="text-[11px] text-gray-400 mt-1 truncate tabular-nums">—</span>
        </div>

      </div>

      <!-- Operational Core: 2 Columns Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

        <!-- Left: Pipeline Dispatcher (7 cols) -->
        <section class="lg:col-span-7 space-y-6">
          <div class="rounded-3xl bg-gray-50/70 border border-gray-200/80 p-6 space-y-6">
            <div class="flex items-center justify-between pb-4 border-b border-gray-200/60">
              <div>
                <h2 class="text-base font-bold text-gray-900">Pipeline Dispatcher</h2>
                <p class="text-xs text-gray-500 mt-0.5">Enqueues Google Apps Script sync task to Proxmox Streaq worker.</p>
              </div>
              <span class="px-2.5 py-1 rounded-full bg-gray-200/70 text-[10px] font-mono font-medium text-gray-600">
                TIMEOUT: 900s
              </span>
            </div>

            <!-- Trigger Button -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4">
              <button
                id="btn-trigger-sync"
                class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-2xl bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white font-semibold text-sm transition-all shadow-md shadow-emerald-600/25 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
                <svg id="sync-spinner" class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                <span id="sync-btn-label">Sync Spreadsheet</span>
              </button>

              <div class="text-xs text-gray-500 sm:text-right space-y-0.5 font-mono text-[11px]">
                <div>Target: <span class="text-gray-900 font-semibold">User KPI (Postgres)</span></div>
                <div>Method: <span class="text-gray-900 font-semibold">Google Apps Script</span></div>
              </div>
            </div>

            <!-- In-Flight Pipeline Monitor (Dynamic Telemetry & Progress Bar) -->
            <div id="sync-monitor-card" class="hidden p-5 rounded-2xl bg-white border border-gray-200/90 shadow-sm space-y-3 transition-all duration-300">
              <!-- Top Row: Status Dot + State Text + Percentage + Live Timer -->
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                  <span id="monitor-pulse" class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
                  <span id="monitor-state" class="text-xs font-bold text-gray-900 tracking-wide uppercase">Initializing Sync...</span>
                </div>
                <div class="flex items-center gap-2">
                  <span id="monitor-pct" class="text-xs font-mono font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-md tabular-nums">0%</span>
                  <span id="monitor-timer" class="text-xs font-mono font-medium text-gray-500 tabular-nums">00:00s</span>
                </div>
              </div>

              <!-- Animated Progress Bar Container -->
              <div class="w-full bg-gray-100 rounded-full h-2.5 overflow-hidden p-0.5 border border-gray-200/60">
                <div id="monitor-bar" class="h-full rounded-full bg-gradient-to-r from-emerald-500 to-teal-500 transition-all duration-500 ease-out shadow-xs" style="width: 5%"></div>
              </div>

              <!-- Stage & Job Info -->
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 text-[11px] font-mono text-gray-500 pt-0.5">
                <span id="monitor-stage-text" class="text-gray-700 font-medium">Stage 1/4: Dispatching task to queue...</span>
                <span id="monitor-job-id" class="truncate max-w-[240px] text-gray-400">Job: —</span>
              </div>

              <!-- Result details / error box -->
              <div id="monitor-details" class="hidden text-xs pt-2.5 border-t border-gray-100 text-gray-600"></div>
            </div>
          </div>

          <!-- Telemetry Ledger Card -->
          <div class="rounded-3xl bg-gray-50/70 border border-gray-200/80 p-6 space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-gray-200/60">
              <div>
                <h2 class="text-base font-bold text-gray-900">Telemetry Ledger</h2>
                <p class="text-xs text-gray-500 mt-0.5">Audit history of recorded pipeline executions.</p>
              </div>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs font-sans">
                <thead>
                  <tr class="border-b border-gray-200 text-gray-400 uppercase text-[10px] font-bold tracking-wider">
                    <th class="py-2.5 px-3">Timestamp (WIB)</th>
                    <th class="py-2.5 px-3">Status</th>
                    <th class="py-2.5 px-3">Users Staged</th>
                    <th class="py-2.5 px-3">Branches</th>
